{
  "name": "usage-dashboard-trial",
  "version": "0.1.0",
  "private": true,
  "description": "Static dashboard of AI usage and spend per assistant and per week (sample data only).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:limits": "vitest run tests/limits.test.ts",
    "collect": "node scripts/collect.mjs",
    "collect:check": "node scripts/collect.mjs --check",
    "check:bundle": "vite-node scripts/run-bundle-budget.ts",
    "check:links": "vite-node scripts/run-check-links.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "chart.js": "^4.4.0"
  }
}
